@page
@model PortailSocadel.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Console d'Administration";
    ViewData["IsAdmin"] = true;
}

<div class="admin-view-container">
    <!-- Header Strip: Title Section -->
    <div class="admin-header-strip">
        <div class="admin-title-area">
            <div class="admin-title-badge">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                    <line x1="8" y1="21" x2="16" y2="21"></line>
                    <line x1="12" y1="17" x2="12" y2="21"></line>
                </svg>
                <span>Console Back-Office &bull; Gestion Décisionnelle</span>
            </div>
            <h2>Administration de l'Arborescence & des Rapports</h2>
            <p>Nouveau menu • Nouveau sous-menu • Nouveau rapport</p>
        </div>
    </div>

    <!-- Action Bar: Quick Add Buttons -->
    <div class="admin-action-bar">
        <button type="button" class="btn-admin-action level1" onclick="openAddModalWithLevel('1')" title="Ajouter un nouveau menu">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>+ Nouveau Menu</span>
        </button>

        <button type="button" class="btn-admin-action level2" onclick="openAddModalWithLevel('2')" title="Ajouter un nouveau sous-menu">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>+ Nouveau Sous-menu</span>
        </button>

        <button type="button" class="btn-admin-action level3" onclick="openAddModalWithLevel('3')" title="Ajouter un nouveau rapport">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="12" y1="5" x2="12" y2="19"></line>
                <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
            <span>+ Nouveau Rapport</span>
        </button>

        <div style="flex: 1;"></div>

        <form method="post" asp-page-handler="Reset" style="display:inline;" onsubmit="return confirm('Attention : Êtes-vous sûr de vouloir réinitialiser l\'ensemble de l\'arborescence aux données par défaut de SOCADEL ?');">
            <button type="submit" class="btn-admin-reset" title="Réinitialiser l'arborescence par défaut">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
                    <path d="M21 3v5h-5"></path>
                    <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
                    <path d="M8 16H3v5"></path>
                </svg>
                <span>Réinitialiser par défaut</span>
            </button>
        </form>
    </div>

    <!-- Alert Notifications -->
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="admin-alert admin-alert-success">
            <div class="admin-alert-content">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span><strong>Succès :</strong> @Model.SuccessMessage</span>
            </div>
            <button type="button" class="admin-alert-close" onclick="this.parentElement.remove()">&times;</button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="admin-alert admin-alert-error">
            <div class="admin-alert-content">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"></circle>
                    <line x1="12" y1="8" x2="12" y2="12"></line>
                    <line x1="12" y1="16" x2="12.01" y2="16"></line>
                </svg>
                <span><strong>Erreur :</strong> @Model.ErrorMessage</span>
            </div>
            <button type="button" class="admin-alert-close" onclick="this.parentElement.remove()">&times;</button>
        </div>
    }

    <!-- Stat KPI Cards Grid -->
    <div class="admin-stats-grid">
        <div class="admin-stat-card">
            <div class="admin-stat-header">
                <span class="admin-stat-label">Nouveau Menu</span>
                <span class="admin-stat-icon blue">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                </span>
            </div>
            <span class="admin-stat-val blue">@Model.TotalCategories</span>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-header">
                <span class="admin-stat-label">Nouveau Sous-menu</span>
                <span class="admin-stat-icon green">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        <line x1="12" y1="11" x2="12" y2="17"></line>
                        <line x1="9" y1="14" x2="15" y2="14"></line>
                    </svg>
                </span>
            </div>
            <span class="admin-stat-val green">@Model.TotalSubCategories</span>
        </div>

        <div class="admin-stat-card">
            <div class="admin-stat-header">
                <span class="admin-stat-label">Nouveau Rapport</span>
                <span class="admin-stat-icon gray">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="3" y1="9" x2="21" y2="9"></line>
                        <line x1="9" y1="21" x2="9" y2="9"></line>
                    </svg>
                </span>
            </div>
            <span class="admin-stat-val dark">@Model.TotalReports</span>
        </div>
    </div>

    <!-- Filter & Search Bar -->
    <div class="admin-filter-bar">
        <div class="admin-search-wrapper">
            <svg class="admin-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input type="text" id="adminTableSearch" class="admin-filter-input" placeholder="Filtrer par intitulé, code, parent ou description..." />
        </div>

        <div class="admin-filter-controls">
            <div class="admin-filter-group">
                <label for="adminTypeFilter">Niveau :</label>
                <select id="adminTypeFilter" class="admin-filter-select">
                    <option value="">Tous les niveaux</option>
                    <option value="1">Niveau 1 — Processus (Catégorie)</option>
                    <option value="2">Niveau 2 — Sous-menu</option>
                    <option value="3">Niveau 3 — Rapport décisionnel</option>
                </select>
            </div>

            <div class="admin-filter-group">
                <label for="adminStatusFilter">Statut :</label>
                <select id="adminStatusFilter" class="admin-filter-select">
                    <option value="">Tous les statuts</option>
                    <option value="active">Actif</option>
                    <option value="inactive">Inactif</option>
                    <option value="error">Simulation Erreur</option>
                </select>
            </div>
        </div>
    </div>

    <!-- Hierarchical Tree Table of Menus & Reports (0 Emojis, Clean Vector Icons) -->
    <div class="admin-table-container">
        <table class="admin-table" id="adminHierarchyTable">
            <thead>
                <tr>
                    <th style="width: 30%;">Structure & Intitulé</th>
                    <th style="width: 14%;">Niveau / Type</th>
                    <th style="width: 16%;">Parent Hiérarchique</th>
                    <th style="width: 12%;">Moteur / Code</th>
                    <th style="width: 7%; text-align: center;">Ordre</th>
                    <th style="width: 9%; text-align: center;">Statut</th>
                    <th style="width: 12%; text-align: right;">Actions CRUD</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cat in Model.TreeItems)
                {
                    <tr data-title="@cat.Title @cat.Description @cat.Code" data-level="1" data-status="@(cat.IsActive ? "active" : "inactive")">
                        <td>
                            <div class="tree-node-cell level-indent-0">
                                <span class="table-node-icon cat-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                </span>
                                <div class="node-text-group">
                                    <strong class="node-title">@cat.Title</strong>
                                    @if (!string.IsNullOrEmpty(cat.Description))
                                    {
                                        <span class="node-description">@cat.Description</span>
                                    }
                                </div>
                            </div>
                        </td>
                        <td><span class="badge badge-level-1">1 &bull; Processus</span></td>
                        <td><span class="text-muted-dash">&mdash; (Racine)</span></td>
                        <td>
                            @if (!string.IsNullOrEmpty(cat.Code))
                            {
                                <span class="badge-code">@cat.Code</span>
                            }
                            else
                            {
                                <span class="text-muted-dash">&mdash;</span>
                            }
                        </td>
                        <td style="text-align: center; font-weight: 600;">@cat.Order</td>
                        <td style="text-align: center;">
                            <span class="badge @(cat.IsActive ? "badge-active" : "badge-inactive")">
                                @(cat.IsActive ? "Actif" : "Inactif")
                            </span>
                        </td>
                        <td style="text-align: right; white-space: nowrap;">
                            <div class="table-action-btns">
                                <button type="button" class="btn-table-action btn-table-add" onclick="openAddChildModal('@cat.Id', '1')" title="Ajouter un sous-menu sous ce processus">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="12" y1="5" x2="12" y2="19"></line>
                                        <line x1="5" y1="12" x2="19" y2="12"></line>
                                    </svg>
                                    <span>+ Sous-menu</span>
                                </button>
                                <button type="button" class="btn-table-action btn-table-edit" onclick="openEditModal('@cat.Id', '@cat.Title', '', '1', '@(cat.Description ?? "")')" title="Modifier ce processus">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </button>
                                <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Supprimer définitivement le processus « @cat.Title » et tous ses sous-menus et rapports associés ?');">
                                    <input type="hidden" name="id" value="@cat.Id" />
                                    <button type="submit" class="btn-table-action btn-table-delete" title="Supprimer ce processus">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>

                    @foreach (var sub in cat.Children)
                    {
                        <tr data-title="@sub.Title @sub.Description @sub.Code @cat.Title" data-level="2" data-status="@(sub.IsActive ? "active" : "inactive")">
                            <td>
                                <div class="tree-node-cell level-indent-1">
                                    <span class="table-node-icon sub-icon">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                            <line x1="12" y1="11" x2="12" y2="17"></line>
                                            <line x1="9" y1="14" x2="15" y2="14"></line>
                                        </svg>
                                    </span>
                                    <div class="node-text-group">
                                        <strong class="node-title">@sub.Title</strong>
                                        @if (!string.IsNullOrEmpty(sub.Description))
                                        {
                                            <span class="node-description">@sub.Description</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-level-2">2 &bull; Sous-menu</span></td>
                            <td>
                                <span class="parent-reference blue">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                    @cat.Title
                                </span>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(sub.Code))
                                {
                                    <span class="badge-code">@sub.Code</span>
                                }
                                else
                                {
                                    <span class="text-muted-dash">&mdash;</span>
                                }
                            </td>
                            <td style="text-align: center; font-weight: 600;">@sub.Order</td>
                            <td style="text-align: center;">
                                <span class="badge @(sub.IsActive ? "badge-active" : "badge-inactive")">
                                    @(sub.IsActive ? "Actif" : "Inactif")
                                </span>
                            </td>
                            <td style="text-align: right; white-space: nowrap;">
                                <div class="table-action-btns">
                                    <button type="button" class="btn-table-action btn-table-add" onclick="openAddChildModal('@sub.Id', '2')" title="Ajouter un rapport décisionnel sous ce sous-menu">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <line x1="12" y1="5" x2="12" y2="19"></line>
                                            <line x1="5" y1="12" x2="19" y2="12"></line>
                                        </svg>
                                        <span>+ Rapport</span>
                                    </button>
                                    <button type="button" class="btn-table-action btn-table-edit" onclick="openEditModal('@sub.Id', '@sub.Title', '@cat.Id', '2', '@(sub.Description ?? "")')" title="Modifier ce sous-menu">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Supprimer définitivement le sous-menu « @sub.Title » et tous ses rapports ?');">
                                        <input type="hidden" name="id" value="@sub.Id" />
                                        <button type="submit" class="btn-table-action btn-table-delete" title="Supprimer ce sous-menu">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        @foreach (var report in sub.Children)
                        {
                            var statusValue = report.SimulateError ? "error" : (report.IsActive ? "active" : "inactive");
                            <tr data-title="@report.Title @report.Description @report.Code @sub.Title @cat.Title" data-level="3" data-status="@statusValue">
                                <td>
                                    <div class="tree-node-cell level-indent-2">
                                        <span class="table-node-icon report-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                                <line x1="3" y1="9" x2="21" y2="9"></line>
                                                <line x1="9" y1="21" x2="9" y2="9"></line>
                                            </svg>
                                        </span>
                                        <div class="node-text-group">
                                            <a href="/?report=@report.Id" class="node-report-link" title="Consulter le rapport dans le portail">
                                                @report.Title
                                            </a>
                                            @if (!string.IsNullOrEmpty(report.Description))
                                            {
                                                <span class="node-description">@report.Description</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge badge-level-3">3 &bull; Rapport</span></td>
                                <td>
                                    <span class="parent-reference green">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                        </svg>
                                        @sub.Title
                                    </span>
                                </td>
                                <td>
                                    <div style="display: flex; flex-direction: column; gap: 3px;">
                                        <span class="badge badge-engine">@report.Engine</span>
                                        @if (!string.IsNullOrEmpty(report.Code))
                                        {
                                            <span class="badge-code">@report.Code</span>
                                        }
                                    </div>
                                </td>
                                <td style="text-align: center; font-weight: 600;">@report.Order</td>
                                <td style="text-align: center;">
                                    @if (report.SimulateError)
                                    {
                                        <span class="badge badge-simulated-error" title="Ce rapport déclenche volontairement l'état d'erreur">
                                            Simulation Erreur
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge @(report.IsActive ? "badge-active" : "badge-inactive")">
                                            @(report.IsActive ? "Actif" : "Inactif")
                                        </span>
                                    }
                                </td>
                                <td style="text-align: right; white-space: nowrap;">
                                    <div class="table-action-btns">
                                        <a href="/?report=@report.Id" class="btn-table-action btn-table-view" title="Tester la visualisation dans le portail">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                <circle cx="12" cy="12" r="3"></circle>
                                            </svg>
                                            <span>Ouvrir</span>
                                        </a>
                                        <button type="button" class="btn-table-action btn-table-edit" onclick="openEditModal('@report.Id', '@report.Title', '@sub.Id', '3', '@(report.Description ?? "")')" title="Modifier ce rapport">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </button>
                                        <form method="post" asp-page-handler="Delete" style="display:inline;" onsubmit="return confirm('Supprimer définitivement le rapport « @report.Title » ?');">
                                            <input type="hidden" name="id" value="@report.Id" />
                                            <button type="submit" class="btn-table-action btn-table-delete" title="Supprimer ce rapport">
                                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polyline points="3 6 5 6 21 6"></polyline>
                                                    <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                </svg>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- =========================================================================
     MODAL: AJOUTER UN NOUVEL ÉLÉMENT (Niveau 1, 2 ou 3)
     ========================================================================= -->
<div class="modal-overlay" id="modalAddItem">
    <div class="modal-dialog">
        <div class="modal-header">
            <div class="modal-title-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                <h3 id="addModalTitle">Ajouter un élément à l'arborescence</h3>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeAdminModal('modalAddItem')">&times;</button>
        </div>
        <form method="post" asp-page-handler="Add">
            <div class="modal-body">
                <input type="hidden" id="addItemType" name="ItemInput.Type" value="3" />

                <div class="form-group" id="addGroupParent">
                    <label class="form-label" for="addItemParentId">Élément parent *</label>
                    <select id="addItemParentId" name="ItemInput.ParentId" class="form-control">
                        <optgroup label="-- Sous-menus disponibles (pour les Rapports Niv. 3) --" id="optgroupSubCategories">
                            @foreach (var sub in Model.SubCategoryOptions)
                            {
                                var parentCat = Model.CategoryOptions.FirstOrDefault(c => c.Id == sub.ParentId);
                                var label = parentCat != null ? $"{parentCat.Title} > {sub.Title}" : sub.Title;
                                <option value="@sub.Id">@label</option>
                            }
                        </optgroup>
                        <optgroup label="-- Menus de niveau 1 (pour les Sous-Menus Niv. 2) --" id="optgroupCategories">
                            @foreach (var cat in Model.CategoryOptions)
                            {
                                <option value="@cat.Id">@cat.Title</option>
                            }
                        </optgroup>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="addItemTitle">Intitulé de l'élément *</label>
                    <input type="text" id="addItemTitle" name="ItemInput.Title" class="form-control" placeholder="Ex: Commercial, Encaissement, Taux de recouvrement..." required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="addItemDescription">Description / Note métier</label>
                    <textarea id="addItemDescription" name="ItemInput.Description" class="form-control form-control-textarea" placeholder="Description détaillée..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" onclick="closeAdminModal('modalAddItem')">Annuler</button>
                <button type="submit" class="btn-modal-submit">Enregistrer l'élément</button>
            </div>
        </form>
    </div>
</div>

<!-- =========================================================================
     MODAL: MODIFIER UN ÉLÉMENT (Niveau 1, 2 ou 3)
     ========================================================================= -->
<div class="modal-overlay" id="modalEditItem">
    <div class="modal-dialog">
        <div class="modal-header">
            <div class="modal-title-wrap">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                </svg>
                <h3>Modifier l'élément</h3>
            </div>
            <button type="button" class="modal-close-btn" onclick="closeAdminModal('modalEditItem')">&times;</button>
        </div>
        <form method="post" asp-page-handler="Edit">
            <input type="hidden" id="editItemId" name="ItemInput.Id" />
            <input type="hidden" id="editItemType" name="ItemInput.Type" value="3" />
            <div class="modal-body">
                <div class="form-group" id="editGroupParent">
                    <label class="form-label" for="editItemParentId">Élément parent</label>
                    <select id="editItemParentId" name="ItemInput.ParentId" class="form-control">
                        <option value="">-- Aucun parent (Racine) --</option>
                        <optgroup label="Menus (Niveau 1)" id="editOptgroupCat">
                            @foreach (var cat in Model.CategoryOptions)
                            {
                                <option value="@cat.Id">@cat.Title</option>
                            }
                        </optgroup>
                        <optgroup label="Sous-Menus (Niveau 2)" id="editOptgroupSub">
                            @foreach (var sub in Model.SubCategoryOptions)
                            {
                                var parentCat = Model.CategoryOptions.FirstOrDefault(c => c.Id == sub.ParentId);
                                var label = parentCat != null ? $"{parentCat.Title} > {sub.Title}" : sub.Title;
                                <option value="@sub.Id">@label</option>
                            }
                        </optgroup>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label" for="editItemTitle">Intitulé de l'élément *</label>
                    <input type="text" id="editItemTitle" name="ItemInput.Title" class="form-control" required />
                </div>

                <div class="form-group">
                    <label class="form-label" for="editItemDescription">Description / Note métier</label>
                    <textarea id="editItemDescription" name="ItemInput.Description" class="form-control form-control-textarea"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-modal-cancel" onclick="closeAdminModal('modalEditItem')">Annuler</button>
                <button type="submit" class="btn-modal-submit">Enregistrer les modifications</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function toggleAddParentSelector() {
            const typeInput = document.getElementById('addItemType');
            const parentGroup = document.getElementById('addGroupParent');
            const optSub = document.getElementById('optgroupSubCategories');
            const optCat = document.getElementById('optgroupCategories');

            if (typeInput.value === '1') {
                parentGroup.style.display = 'none';
            } else if (typeInput.value === '2') {
                parentGroup.style.display = 'block';
                optCat.style.display = '';
                optSub.style.display = 'none';
                if (optCat.children.length > 0) {
                    document.getElementById('addItemParentId').value = optCat.children[0].value;
                }
            } else {
                parentGroup.style.display = 'block';
                optCat.style.display = 'none';
                optSub.style.display = '';
                if (optSub.children.length > 0) {
                    document.getElementById('addItemParentId').value = optSub.children[0].value;
                }
            }
        }

        function toggleEditParentSelector() {
            const typeInput = document.getElementById('editItemType');
            const parentGroup = document.getElementById('editGroupParent');
            const optSub = document.getElementById('editOptgroupSub');
            const optCat = document.getElementById('editOptgroupCat');

            if (typeInput.value === '1') {
                parentGroup.style.display = 'none';
            } else if (typeInput.value === '2') {
                parentGroup.style.display = 'block';
                optCat.style.display = '';
                optSub.style.display = 'none';
            } else {
                parentGroup.style.display = 'block';
                optCat.style.display = 'none';
                optSub.style.display = '';
            }
        }

        window.openAddModalWithLevel = function(level) {
            document.getElementById('addItemType').value = level;
            document.getElementById('addItemTitle').value = '';
            document.getElementById('addItemDescription').value = '';
            toggleAddParentSelector();
            openAdminModal('modalAddItem');
        };

        window.openEditModal = function(id, title, parentId, type, description) {
            document.getElementById('editItemId').value = id || '';
            document.getElementById('editItemTitle').value = title || '';
            document.getElementById('editItemType').value = type || '3';
            document.getElementById('editItemDescription').value = description || '';
            
            toggleEditParentSelector();
            document.getElementById('editItemParentId').value = parentId || '';

            openAdminModal('modalEditItem');
        };

        document.addEventListener('DOMContentLoaded', function() {
            toggleAddParentSelector();
        });
    </script>
}
