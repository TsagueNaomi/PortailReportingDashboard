@page
@model PortailSocadel.Pages.IndexModel
@using PortailSocadel.Services
@using PortailSocadel.Models
@inject INavigationService _navService
@{
}

@if (Model.IsHome)
{
    <!-- =========================================================================
         ÉCRAN D'ACCUEIL OPTIMISÉ - SANS MENU LATÉRAL
         ========================================================================= -->
    <div class="home-container">
        <!-- Section: En-tête avec message de bienvenue -->
        <div class="home-header">
            <div class="home-header-content">
                <!-- Icône centrale -->
                <div class="home-icon-container" aria-hidden="true">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3"></polyline>
                        <line x1="12" y1="12" x2="20" y2="7.5"></line>
                        <line x1="12" y1="12" x2="12" y2="21"></line>
                        <line x1="12" y1="12" x2="4" y2="7.5"></line>
                    </svg>
                </div>

                <!-- Titre et instruction -->
                <h1 class="home-title">Bienvenue sur le portail de reporting</h1>
                <p class="home-subtitle">Accédez aux rapports et tableaux de bord décisionnels de SOCADEL. Explorez nos rapports les plus consultés ou naviguez dans l'arborescence complète.</p>
            </div>
        </div>

        <!-- Section: Grille de rapports en vedette -->
        <div class="home-featured-section">
            <h2 class="home-section-title">Rapports les plus consultés</h2>
            
            <div class="home-reports-grid">
                @foreach (var report in Model.FeaturedReports)
                {
                    var parentReport = _navService.GetItemById(report.ParentId ?? "");
                    var category = _navService.GetItemById(parentReport?.ParentId ?? "");
                    var categoryLabel = category?.Title ?? "Portail";
                    var subcategoryLabel = parentReport?.Title ?? "Rapports";

                    <a href="/?report=@report.Id" class="report-card" title="@report.Title">
                        <!-- Location Badge for Non-Technical Users -->
                        <div class="report-card-location-badge">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                            </svg>
                            <span>@categoryLabel &rsaquo; @subcategoryLabel</span>
                        </div>

                        <div class="report-card-header-row">
                            <div class="report-card-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <line x1="12" y1="20" x2="12" y2="10"></line>
                                    <line x1="18" y1="20" x2="18" y2="4"></line>
                                    <line x1="6" y1="20" x2="6" y2="16"></line>
                                </svg>
                            </div>
                            <h3 class="report-card-title">@report.Title</h3>
                        </div>

                        @if (!string.IsNullOrEmpty(report.Description))
                        {
                            <p class="report-card-description">@report.Description</p>
                        }

                        <div class="report-card-footer">
                            <span class="btn-card-action">Consulter le rapport &rarr;</span>
                        </div>
                    </a>
                }
            </div>

            @if (!Model.FeaturedReports.Any())
            {
                <div class="home-empty-state">
                    <p>Aucun rapport disponible pour le moment.</p>
                </div>
            }
        </div>
    </div>
}
else if (Model.IsError)
{
    <!-- =========================================================================
         2. ÉTAT D'ERREUR INTÉGRÉ AU RAPPORT SÉLECTIONNÉ (Point 3)
         ========================================================================= -->
    <div class="error-screen-container">
        <!-- Warning Triangle Icon -->
        <div class="error-warning-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                <line x1="12" y1="9" x2="12" y2="13"></line>
                <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
        </div>

        <!-- Error Messages -->
        <h2 class="error-main-title">Impossible de charger le rapport.</h2>
        <p class="error-sub-title">Veuillez réessayer.</p>

        <!-- Technical Context Card -->
        <div class="error-details-box">
            <div class="error-detail-row">
                <span class="error-detail-label">Rapport sélectionné :</span>
                <span class="error-detail-value">@(Model.CurrentReport?.Title ?? "Rapport décisionnel")</span>
            </div>
            <div class="error-detail-row">
                <span class="error-detail-label">Code d'incident :</span>
                <span class="error-detail-value error-code-pill">ERR_GATEWAY_TIMEOUT (504)</span>
            </div>
            <div class="error-detail-row">
                <span class="error-detail-label">Diagnostic :</span>
                <span class="error-detail-value">La source de données distante ne répond pas dans le délai imparti.</span>
            </div>
        </div>

        <!-- Action Button -->
        <button type="button" class="btn-retry-action" onclick="retryReportLoading(this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.19"></path>
            </svg>
            <span>Réessayer</span>
        </button>
    </div>
}
else
{
    <!-- =========================================================================
         3. RAPPORT ACTIF SÉLECTIONNÉ ET AFFICHÉ (Power BI Simulation)
         ========================================================================= -->
    <div class="pbi-report-container">
        <!-- Top Dark Bar: Power BI Header -->
        <div class="pbi-top-bar">
            <div class="pbi-top-left">
                <span class="pbi-brand-tag">Power BI</span>
                <span class="pbi-report-title-top">@(Model.CurrentReport?.Title ?? "Tableau de bord de reporting")</span>
            </div>
            <div class="pbi-top-right">
                <span class="pbi-engine-badge">@(Model.CurrentReport?.Engine.ToString() ?? "PowerBI")</span>
                <span class="pbi-refresh-badge">Actualisé en temps réel</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.CurrentReport?.ReportUrl))
        {
            <!-- Affichage dynamique du rapport externe Power BI via IFrame -->
            <div class="pbi-iframe-wrapper" style="width: 100%; height: calc(100% - 36px); background-color: #FFFFFF;">
                <iframe src="@Model.CurrentReport.ReportUrl" 
                        title="@Model.CurrentReport.Title"
                        width="100%" 
                        height="100%" 
                        frameborder="0" 
                        allowFullScreen="true"
                        style="border: none; display: block;">
                </iframe>
            </div>
        }
        else
        {
            <!-- Dashboard Grid Simulation Visual Tiles (Default fallback) -->
            <div class="pbi-dashboard-body">
            <!-- TILE 1: Line Chart Visual -->
            <div class="pbi-tile" title="Évolution temporelle">
                <div class="pbi-tile-header">
                    <span class="pbi-tile-title">Évolution chronologique des flux</span>
                </div>
                <div class="line-chart-container">
                    <svg class="line-chart-svg" viewBox="0 0 320 160" preserveAspectRatio="none">
                        <!-- Grid lines -->
                        <line x1="10" y1="30" x2="310" y2="30" stroke="#EDF2F7" stroke-width="1" />
                        <line x1="10" y1="70" x2="310" y2="70" stroke="#EDF2F7" stroke-width="1" />
                        <line x1="10" y1="110" x2="310" y2="110" stroke="#EDF2F7" stroke-width="1" />
                        <line x1="10" y1="150" x2="310" y2="150" stroke="#EDF2F7" stroke-width="1" />

                        <!-- Blue Line (#1D70B8) -->
                        <polyline fill="none" stroke="#1D70B8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                  points="15,120 60,95 105,115 150,80 195,50 240,75 285,55 305,65" />
                        
                        <!-- Green Line (#7CB342) -->
                        <polyline fill="none" stroke="#7CB342" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                                  points="15,135 60,110 105,100 150,110 195,90 240,65 285,45 305,50" />

                        <!-- Blue Data Dots -->
                        <circle cx="15" cy="120" r="3.5" fill="#1D70B8" />
                        <circle cx="60" cy="95" r="3.5" fill="#1D70B8" />
                        <circle cx="105" cy="115" r="3.5" fill="#1D70B8" />
                        <circle cx="150" cy="80" r="3.5" fill="#1D70B8" />
                        <circle cx="195" cy="50" r="3.5" fill="#1D70B8" />
                        <circle cx="240" cy="75" r="3.5" fill="#1D70B8" />
                        <circle cx="285" cy="55" r="3.5" fill="#1D70B8" />

                        <!-- Green Data Dots -->
                        <circle cx="15" cy="135" r="3.5" fill="#7CB342" />
                        <circle cx="60" cy="110" r="3.5" fill="#7CB342" />
                        <circle cx="105" cy="100" r="3.5" fill="#7CB342" />
                        <circle cx="150" cy="110" r="3.5" fill="#7CB342" />
                        <circle cx="195" cy="90" r="3.5" fill="#7CB342" />
                        <circle cx="240" cy="65" r="3.5" fill="#7CB342" />
                        <circle cx="285" cy="45" r="3.5" fill="#7CB342" />
                    </svg>
                </div>
            </div>

            <!-- TILE 2: Vertical Bar Chart Visual -->
            <div class="pbi-tile" title="Répartition mensuelle">
                <div class="pbi-tile-header">
                    <span class="pbi-tile-title">Volumes réalisés par période</span>
                </div>
                <div class="v-bar-container">
                    <div class="v-bar blue" style="height: 35%;" data-label="Janvier" data-val="35 K"></div>
                    <div class="v-bar green" style="height: 52%;" data-label="Février" data-val="52 K"></div>
                    <div class="v-bar blue" style="height: 72%;" data-label="Mars" data-val="72 K"></div>
                    <div class="v-bar green" style="height: 85%;" data-label="Avril" data-val="85 K"></div>
                    <div class="v-bar blue" style="height: 60%;" data-label="Mai" data-val="60 K"></div>
                    <div class="v-bar green" style="height: 42%;" data-label="Juin" data-val="42 K"></div>
                    <div class="v-bar blue" style="height: 25%;" data-label="Juillet" data-val="25 K"></div>
                    <div class="v-bar green" style="height: 38%;" data-label="Août" data-val="38 K"></div>
                </div>
            </div>

            <!-- TILE 3: Horizontal Bar Chart Visual -->
            <div class="pbi-tile" title="Performance par région">
                <div class="pbi-tile-header">
                    <span class="pbi-tile-title">Ventilation géographique</span>
                </div>
                <div class="h-bar-container">
                    <div class="h-bar-row" style="justify-content: flex-end;">
                        <div class="h-bar blue" style="width: 82%;" data-label="Littoral (Douala)" data-val="82 %"></div>
                    </div>
                    <div class="h-bar-row" style="justify-content: flex-end;">
                        <div class="h-bar green" style="width: 50%;" data-label="Centre (Yaoundé)" data-val="50 %"></div>
                    </div>
                    <div class="h-bar-row" style="justify-content: flex-start;">
                        <div class="h-bar blue" style="width: 92%;" data-label="Ouest (Bafoussam)" data-val="92 %"></div>
                    </div>
                    <div class="h-bar-row" style="justify-content: flex-end;">
                        <div class="h-bar green" style="width: 62%;" data-label="Nord (Garoua)" data-val="62 %"></div>
                    </div>
                </div>
            </div>

            <!-- TILE 4: Vertical Bar Chart Visual (Bottom Left) -->
            <div class="pbi-tile" title="Activité hebdomadaire">
                <div class="pbi-tile-header">
                    <span class="pbi-tile-title">Suivi hebdomadaire des opérations</span>
                </div>
                <div class="v-bar-container">
                    <div class="v-bar blue" style="height: 22%;" data-label="Semaine 1" data-val="22 K"></div>
                    <div class="v-bar green" style="height: 38%;" data-label="Semaine 2" data-val="38 K"></div>
                    <div class="v-bar blue" style="height: 56%;" data-label="Semaine 3" data-val="56 K"></div>
                    <div class="v-bar green" style="height: 72%;" data-label="Semaine 4" data-val="72 K"></div>
                    <div class="v-bar green" style="height: 94%;" data-label="Semaine 5" data-val="94 K"></div>
                    <div class="v-bar blue" style="height: 62%;" data-label="Semaine 6" data-val="62 K"></div>
                    <div class="v-bar green" style="height: 48%;" data-label="Semaine 7" data-val="48 K"></div>
                </div>
            </div>

            <!-- TILE 5: KPI Card 1 -->
            <div class="pbi-tile" title="Volume global">
                <div class="pbi-tile-header">
                    <span class="pbi-tile-title">Indicateur consolidé</span>
                </div>
                <div class="kpi-container">
                    <div class="kpi-main-number">73.9K</div>
                    <div class="kpi-caption">Total cumulé exercice</div>
                </div>
            </div>

            <!-- TILE 6: KPI Card 2 -->
            <div class="pbi-tile" title="Progression">
                <div class="pbi-tile-header">
                    <span class="pbi-tile-title">Tendance N / N-1</span>
                </div>
                <div class="kpi-container">
                    <div class="kpi-main-number green-accent">+1.6%</div>
                    <div class="kpi-caption">Évolution par rapport à la période précédente</div>
                </div>
            </div>
        </div>
        }
    </div>
}
