@page
@model PortailSocadel.Pages.LoginModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Connexion - Portail SOCADEL";
}

<div class="auth-card">
    <div class="auth-header">
        <img src="~/images/logo-socadel.jpg" alt="SOCADEL Logo" class="auth-logo" />
        <h1>Portail Décisionnel</h1>
        <p>Veuillez vous connecter avec votre adresse e-mail pour accéder aux rapports et tableaux de bord SOCADEL</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="auth-alert" role="alert">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
            <div asp-validation-summary="All" class="d-inline text-start mb-0"></div>
        </div>
    }

    <form method="post" class="auth-form">
        <div class="form-group">
            <label asp-for="Input.Email">Adresse E-mail</label>
            <div class="auth-input-wrapper">
                <span class="auth-input-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                </span>
                <input asp-for="Input.Email" class="auth-input" placeholder="nom.prenom@socadel.cm" autocomplete="username" required autofocus />
            </div>
            <span asp-validation-for="Input.Email" class="text-danger small ms-1"></span>
        </div>

        <div class="form-group">
            <label asp-for="Input.Password">Mot de passe</label>
            <div class="auth-input-wrapper">
                <span class="auth-input-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                </span>
                <input asp-for="Input.Password" class="auth-input" type="password" placeholder="••••••••" autocomplete="current-password" required />
            </div>
            <span asp-validation-for="Input.Password" class="text-danger small ms-1"></span>
        </div>

        <button type="submit" class="btn-auth-submit">
            <span>Se Connecter</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </button>
    </form>
</div>
