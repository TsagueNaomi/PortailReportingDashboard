@inject INavigationService NavService
@using PortailSocadel.Models
@using PortailSocadel.Services
@{
    var tree = NavService.GetMenuTree();
    var activeReportId = ViewData["ActiveReportId"]?.ToString() ?? Context.Request.Query["report"].ToString();
    var isHome = string.IsNullOrEmpty(activeReportId) && !Context.Request.Path.StartsWithSegments("/Admin");
    var isExplore = ViewData["IsExplore"] as bool? == true;
    var isError = ViewData["IsError"] as bool? == true;
    var isAdmin = Context.Request.Path.StartsWithSegments("/Admin") || ViewData["IsAdmin"] as bool? == true;

    // Determine current breadcrumbs
    List<string> breadcrumbs = new();
    if (isAdmin)
    {
        breadcrumbs = new List<string> { "Portail", "Console d'Administration", "Gestion de l'Arborescence & Rapports" };
    }
    else if (isHome)
    {
        breadcrumbs = new List<string> { "Portail", "Accueil" };
    }
    else if (!string.IsNullOrEmpty(activeReportId))
    {
        breadcrumbs = NavService.GetBreadcrumbPath(activeReportId);
        if (!breadcrumbs.Any())
        {
            breadcrumbs = new List<string> { "Portail", "Commercial", "Rapport Décisionnel" };
        }
    }
    else
    {
        breadcrumbs = new List<string> { "Portail", "Accueil" };
    }
}
@functions {
    public static Microsoft.AspNetCore.Html.IHtmlContent RenderSubTree(List<MenuItem>? items, string activeReportId, bool isHome)
    {
        if (items == null) return new Microsoft.AspNetCore.Html.HtmlString("");
        var sb = new System.Text.StringBuilder();
        sb.Append("<ul class=\"tree-level-2-list tree-sub-list\">");
        foreach (var item in items)
        {
            var hasChildren = item.Children != null && item.Children.Any();
            var isReport = item.Type == ItemType.Report;
            var isItemActive = !string.IsNullOrEmpty(activeReportId) && (item.Id == activeReportId || (hasChildren && HasActiveDescendant(item, activeReportId)));
            var isCollapsed = !isItemActive;

            if (isReport)
            {
                var isActive = item.Id == activeReportId;
                sb.Append($"<li class=\"tree-level-3-item tree-report-item\" data-id=\"{item.Id}\" data-title=\"{item.Title}\">");
                sb.Append($"<a href=\"/?report={item.Id}\" class=\"tree-report-link {(isActive ? "active" : "")}\" data-id=\"{item.Id}\" data-title=\"{item.Title}\" data-url=\"{item.ReportUrl ?? ""}\" title=\"{item.Description ?? ""}\">");
                sb.Append("<span class=\"tree-report-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"></line><line x1=\"9\" y1=\"21\" x2=\"9\" y2=\"9\"></line></svg></span>");
                sb.Append($"<span class=\"report-link-text\">{item.Title}</span>");
                sb.Append("</a></li>");
            }
            else
            {
                sb.Append($"<li class=\"tree-level-2-item tree-sub-item {(isCollapsed ? "collapsed" : "")}\" data-id=\"{item.Id}\" data-title=\"{item.Title}\">");
                sb.Append($"<div class=\"tree-sub-header\" title=\"{item.Description ?? ""}\">");
                sb.Append("<span class=\"tree-caret\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg></span>");
                sb.Append("<span class=\"tree-level-icon sub-icon\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z\"></path><line x1=\"12\" y1=\"11\" x2=\"12\" y2=\"17\"></line><line x1=\"9\" y1=\"14\" x2=\"15\" y2=\"14\"></line></svg></span>");
                sb.Append($"<span class=\"tree-title\">{item.Title}</span>");
                sb.Append("</div>");
                
                if (hasChildren)
                {
                    sb.Append(RenderSubTree(item.Children, activeReportId, isHome).ToString());
                }
                sb.Append("</li>");
            }
        }
        sb.Append("</ul>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    public static bool HasActiveDescendant(MenuItem parent, string activeReportId)
    {
        if (parent.Children == null) return false;
        foreach (var child in parent.Children)
        {
            if (child.Id == activeReportId || HasActiveDescendant(child, activeReportId)) return true;
        }
        return false;
    }
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Portail Décisionnel") - SOCADEL</title>
    
    <!-- Pure Vanilla CSS Stylesheet -->
    <link rel="stylesheet" href="~/css/portal.css" asp-append-version="true" />
</head>
<body>
    <div class="app-container">
        <!-- =================================================================
             1. LEFT SIDEBAR NAVIGATION (~22% width, exact SOCADEL structure)
             ================================================================= -->
        <aside class="app-sidebar">
            <!-- 1.1 SOCADEL Official Logo -->
            <div class="sidebar-header">
                <a href="/" class="sidebar-logo-link" title="Accueil Portail SOCADEL">
                    <img src="~/images/logo-socadel.jpg" alt="SOCADEL - Société Camerounaise d'Electricité" class="sidebar-logo-img" />
                </a>
            </div>

            <!-- 1.2 Sidebar Search Input + Search & Clear Buttons -->
            <div class="sidebar-search-box">
                <div class="sidebar-search-input-wrapper">
                    <svg class="sidebar-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="sidebarSearchInput" class="sidebar-search-input" placeholder="Rechercher un rapport..." autocomplete="off" />
                    <button type="button" id="sidebarSearchClear" class="sidebar-search-clear" title="Effacer la recherche" style="display:none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Search match status indicator (hidden by default) -->
            <div id="sidebarSearchBadge" class="sidebar-search-badge" style="display: none;"></div>

            <!-- 1.3 Collapsible / Expandable Tree Menu (Multi-Levels Recursive) -->
            <nav class="sidebar-nav-container" aria-label="Menu principal">
                <ul class="tree-root" id="sidebarTreeRoot">
                    @foreach (var cat in tree)
                    {
                        var isCatActive = !string.IsNullOrEmpty(activeReportId) && HasActiveDescendant(cat, activeReportId);
                        var isCommercial = cat.Title.Equals("Commercial", StringComparison.OrdinalIgnoreCase);
                        var isCatCollapsed = !isCatActive;

                        <li class="tree-level-1-item @(isCatCollapsed ? "collapsed" : "")" data-id="@cat.Id" data-title="@cat.Title">
                            <div class="tree-cat-header" title="@cat.Description">
                                <span class="tree-caret">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="6 9 12 15 18 9"></polyline>
                                    </svg>
                                </span>
                                <span class="tree-level-icon cat-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                                    </svg>
                                </span>
                                <span class="tree-title">@cat.Title</span>
                            </div>

                            @if (cat.Children.Any())
                            {
                                @RenderSubTree(cat.Children, activeReportId, isHome)
                            }
                        </li>
                    }
                </ul>
            </nav>

            <!-- 1.4 Dedicated Back-Office Administration Box (Visible only when in Admin Role) -->
            <div class="sidebar-admin-box">
                <a href="/Admin" class="sidebar-admin-card @(isAdmin ? "active" : "")" title="Console d'Administration & Back-Office">
                    <div class="sidebar-admin-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="3"></circle>
                            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                        </svg>
                    </div>
                    <div class="sidebar-admin-text">
                        <div class="sidebar-admin-title">Administration</div>
                        <div class="sidebar-admin-subtitle">Gestion des menus & rapports</div>
                    </div>
                    <span class="sidebar-admin-arrow">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </span>
                </a>
            </div>
        </aside>

        <!-- =================================================================
             2. MAIN CONTENT AREA (Right Side)
             ================================================================= -->
        <main class="app-main">
            <!-- 2.1 Top Corporate Blue Header (#1D70B8) -->
            <header class="main-header">
                <!-- Left header area / Brand indicator -->
                <div class="header-left-area">
                    <a href="/" class="header-home-btn" title="Retour à l'accueil du portail">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                        <span>Accueil Portail</span>
                    </a>
                </div>

                <!-- Centered Enhanced Search Bar in Blue Header -->
                <div class="header-search-container" id="headerSearchBox">
                    <svg class="header-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    <input type="text" id="headerSearchInput" class="header-search-input" placeholder="Rechercher un rapport..." autocomplete="off" />
                    <button type="button" id="headerSearchClear" class="header-search-clear-btn" title="Effacer" style="display:none;">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                    <!-- Search Results Floating Dropdown -->
                    <div id="headerSearchResults" class="header-search-results-dropdown" style="display:none;"></div>
                </div>

                <!-- Right Section: Administration Link + User Profile & Auth -->
                <div class="header-right-area">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            @if (isAdmin)
                            {
                                <a href="/" class="header-admin-action-btn back-to-portal" title="Quitter l'administration et revenir à la consultation">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <line x1="19" y1="12" x2="5" y2="12"></line>
                                        <polyline points="12 19 5 12 12 5"></polyline>
                                    </svg>
                                    <span>Retour au Portail</span>
                                </a>
                            }
                            else
                            {
                                <a href="/Admin" class="header-admin-action-btn go-to-admin" title="Accéder à la console d'administration">
                                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <circle cx="12" cy="12" r="3"></circle>
                                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                    </svg>
                                    <span>Administration</span>
                                </a>
                            }
                        }

                        <!-- User Profile Badge -->
                        <div class="header-user-badge d-flex align-items-center gap-2">
                            <span class="user-single-name">@User.Identity.Name</span>
                            <span class="badge @(User.IsInRole("Admin") ? "bg-danger" : "bg-primary")" style="font-size: 0.7rem; padding: 3px 7px;">
                                @(User.IsInRole("Admin") ? "Admin" : "User")
                            </span>
                        </div>

                        <a href="/Logout" class="header-logout-btn text-decoration-none" title="Se déconnecter de la session">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                            <span>Déconnexion</span>
                        </a>
                    }
                    else
                    {
                        <a href="/Login" class="header-admin-action-btn go-to-admin text-decoration-none">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"></path>
                                <polyline points="10 17 15 12 10 7"></polyline>
                                <line x1="15" y1="12" x2="3" y2="12"></line>
                            </svg>
                            <span>Se Connecter</span>
                        </a>
                    }
                </div>
            </header>

            <!-- 2.2 Sub-Header -->
            <div class="page-subheader">
                <nav class="breadcrumb-nav" aria-label="Fil d'Ariane">
                    <a href="/" class="breadcrumb-home-link" title="Accueil">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                            <polyline points="9 22 9 12 15 12 15 22"></polyline>
                        </svg>
                    </a>
                    <span class="breadcrumb-separator">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </span>

                    @{
                        var breadcrumbNodes = !string.IsNullOrEmpty(activeReportId) ? NavService.GetBreadcrumbNodes(activeReportId) : new List<MenuItem>();
                    }

                    @if (isAdmin)
                    {
                        <a href="/" class="breadcrumb-item-link" title="Retourner à l'accueil du portail">Portail</a>
                        <span class="breadcrumb-separator">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </span>
                        <a href="/Admin" class="breadcrumb-item-link" title="Console d'Administration">Console d'Administration</a>
                        <span class="breadcrumb-separator">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </span>
                        <span class="breadcrumb-item-link breadcrumb-current-page" aria-current="page">Arborescence &amp; Rapports</span>
                    }
                    else if (isHome || !breadcrumbNodes.Any())
                    {
                        <a href="/" class="breadcrumb-item-link breadcrumb-current-page" aria-current="page">Accueil</a>
                    }
                    else
                    {
                        for (int i = 0; i < breadcrumbNodes.Count; i++)
                        {
                            var node = breadcrumbNodes[i];
                            var isLast = i == breadcrumbNodes.Count - 1;

                            if (node.Type == ItemType.Report)
                            {
                                <a href="/?report=@node.Id" class="breadcrumb-item-link @(isLast ? "breadcrumb-current-page" : "")" title="Accéder au rapport @node.Title">@node.Title</a>
                            }
                            else
                            {
                                <a href="#" class="breadcrumb-item-link breadcrumb-item-clickable" onclick="handleBreadcrumbClick(event, '@node.Id')" title="Ouvrir la section @node.Title dans le menu">@node.Title</a>
                            }

                            if (!isLast)
                            {
                                <span class="breadcrumb-separator">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <polyline points="9 18 15 12 9 6"></polyline>
                                    </svg>
                                </span>
                            }
                        }
                    }
                </nav>

                <div class="subheader-actions">
                    <!-- Plein écran button -->
                    <button type="button" class="action-btn-green" id="btnFullscreen" title="Basculer en plein écran" aria-label="Plein écran">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="15 3 21 3 21 9"></polyline>
                            <polyline points="9 21 3 21 3 15"></polyline>
                            <line x1="21" y1="3" x2="14" y2="10"></line>
                            <line x1="3" y1="21" x2="10" y2="14"></line>
                        </svg>
                    </button>
                    <!-- Actualiser button -->
                    <button type="button" class="action-btn-green" id="btnRefresh" title="Actualiser le rapport" aria-label="Actualiser">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.19" />
                        </svg>
                    </button>
                </div>
            </div>

            <!-- 2.3 Main Report Workspace Card -->
            <section class="report-workspace" id="mainReportWorkspace">
                @RenderBody()
            </section>
        </main>
    </div>

    <!-- MODAL OVERLAY: Formulaire de Connexion Obligatoire au Démarrage -->
    <div class="modal-overlay login-overlay" id="modalAppLogin" style="display: flex;">
        <div class="modal-dialog login-modal-dialog">
            <div class="login-card-header">
                <img src="/images/logo-socadel.jpg" alt="SOCADEL Logo" class="login-logo-img" />
                <h2>Portail Décisionnel SOCADEL</h2>
                <p>Portail de reporting &amp; dashboard - Veuillez vous connecter avec vos identifiants d'accès</p>
            </div>

            <!-- Formulaire de Connexion -->
            <form id="formAppLogin" onsubmit="handleLoginSubmit(event)">
                <div class="login-modal-body">
                    <div id="loginAlert" class="login-alert" style="display: none;"></div>

                    <div class="form-group">
                        <label class="form-label" for="loginEmail">Adresse e-mail *</label>
                        <input type="email" id="loginEmail" class="form-control login-input" placeholder="ex: user@socadel.cm" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="loginPassword">Mot de passe *</label>
                        <input type="password" id="loginPassword" class="form-control login-input" placeholder="••••••••" required />
                    </div>
                </div>

                <div class="login-modal-footer">
                    <button type="submit" class="btn-login-submit">
                        <span>Se connecter</span>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                            <polyline points="12 5 19 12 12 19"></polyline>
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Master Scripts -->
    <script src="~/js/portal.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>